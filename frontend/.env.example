# Base URL for the FastAPI backend. Defaults to /api, which Vite proxies to
# http://127.0.0.1:8000 in dev and which is same-origin once FastAPI serves
# the built frontend.
# VITE_API_BASE=/api

# MapLibre base map style. Defaults to CARTO Positron; point this at a
# self-hosted style to run without internet access.
# VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
